# ID de medicao do GA4 (formato G-XXXXXXX). Sem essa variavel, o modulo em
# client/src/lib/analytics.ts fica totalmente desligado (no-op) e nenhuma
# requisicao pra googletagmanager.com acontece — dev e preview ficam limpos
# por padrao. So carrega em build de producao (import.meta.env.PROD).
VITE_GA_MEASUREMENT_ID=

# Chave de API do Resend, usada por api/contact.ts para enviar o e-mail do
# formulario de contato.
RESEND_API_KEY=
